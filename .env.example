APP_ENV=local
APP_DEBUG=true
APP_LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/app
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://redis:6379/0
# Optional dedicated Redis for rate-limit counters (defaults to REDIS_URL).
# In production REDIS_URL must use a password or TLS (rediss://) — it holds tokens.
# RATE_LIMIT_REDIS_URL=redis://redis:6379/1

KEYCLOAK_ISSUER=http://keycloak:8080/realms/bap
# Browser-facing issuer (authorize/end_session + token `iss`); defaults to
# KEYCLOAK_ISSUER. Set when Keycloak's internal and public URLs differ (docker/ingress).
# KEYCLOAK_PUBLIC_ISSUER=http://localhost:8080/realms/bap
KEYCLOAK_AUDIENCE=bap-backend
KEYCLOAK_JWKS_CACHE_TTL=3600
KEYCLOAK_TENANT_CLAIM=tenant_id
# Accepted `typ` payload claim for access tokens (Keycloak emits "Bearer").
# KEYCLOAK_EXPECTED_TOKEN_TYPES=Bearer

# Keycloak Admin API (leave empty to disable)
KEYCLOAK_REALM=bap
KEYCLOAK_ADMIN_CLIENT_ID=bap-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=

# OIDC client (BFF model: backend is a confidential client and holds the user's tokens)
OIDC_CLIENT_ID=bap-backend
OIDC_CLIENT_SECRET=change-me-in-prod
# URL the browser uses to reach the backend (and that Keycloak redirects to)
PUBLIC_BASE_URL=http://localhost:8000
# URL the browser uses to reach the SPA (post-login / post-logout landing)
FRONTEND_BASE_URL=http://localhost:5173

# Sessions (opaque cookie → Redis-backed token store)
SESSION_COOKIE_NAME=bap_session
SESSION_TTL_SECONDS=36000
SESSION_IDLE_SECONDS=1800
# AES-256-GCM keys (base64, 32 bytes) encrypting tokens at rest in Redis.
# Comma-separated for rotation (first encrypts, all are tried on decrypt).
# Optional locally (plaintext fallback); MANDATORY in production.
# Generate: python -c "from app.core.crypto import generate_key; print(generate_key())"
# SESSION_ENCRYPTION_KEYS=

# Rate limiting (per authenticated user, fixed-window in Redis)
RATE_LIMIT_GLOBAL_PER_MINUTE=120
RATE_LIMIT_WRITES_PER_MINUTE=30
# Aggregate ceiling per tenant (0 disables) and per-IP cap for pre-auth endpoints.
RATE_LIMIT_TENANT_PER_MINUTE=6000
RATE_LIMIT_AUTH_PER_MINUTE_PER_IP=20
# Strict per-IP cap (1-hour window) for the expensive public signup endpoint.
RATE_LIMIT_SIGNUP_PER_HOUR_PER_IP=5
# Aggregate signup ceiling across ALL IPs per hour (0 disables) — backstop against
# distributed sources (botnet / proxy pool) that each stay under the per-IP cap.
RATE_LIMIT_SIGNUP_GLOBAL_PER_HOUR=50

# Public self-service company registration (POST /v1/signup). Set to false for an
# invite-only / sales-led deployment so tenants are created only by an operator.
SIGNUP_ENABLED=true
# Force email verification for self-service founders (Keycloak VERIFY_EMAIL + a
# verification email). Needs SMTP on the realm. Leave false for no-SMTP setups; set
# true for any public/internet-facing deployment to prevent email squatting.
SIGNUP_REQUIRE_EMAIL_VERIFICATION=false

# Maximum request body size in bytes (default 1 MB)
MAX_BODY_SIZE_BYTES=1048576

# Restrict Host header to these values in production (comma-separated, empty = disabled)
# TRUSTED_HOSTS=api.example.com

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- AI intake (ai_structuring) ---
# Leave OPENAI_API_KEY empty to disable the AI chat intake entirely (503).
# NOTE: chat turns are sent to the provider — PII egress consideration.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
