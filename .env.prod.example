# Production environment for the compose stack.
#   make env-prod          # copies this file to .env.prod
#   $EDITOR .env.prod      # replace EVERY CHANGE_ME
#   make prod-up
#
# This file is read TWICE: by compose itself (--env-file, for ${VAR} interpolation
# in docker-compose*.yml) and by the app container (env_file: .env.prod).
# Full procedure: DEPLOY_VPS.md.

# ---- Hosts (both need an A-record pointing at this VPS) -------------------
APP_HOST=korxona.com
KC_HOSTNAME=auth.korxona.com

# ---- Public URLs (browser-facing; prod refuses to boot on http://) --------
PUBLIC_BASE_URL=https://korxona.com
FRONTEND_BASE_URL=https://korxona.com
KEYCLOAK_PUBLIC_ISSUER=https://auth.korxona.com/realms/bap
# Host-header allowlist and CORS — must list the public app host.
TRUSTED_HOSTS=korxona.com
CORS_ORIGINS=https://korxona.com

# ---- App -----------------------------------------------------------------
APP_DEBUG=false
APP_LOG_LEVEL=INFO
# Internal deployment: tenants are created by the operator (provision_tenant.py),
# not by public self-service signup.
SIGNUP_ENABLED=false
MAX_BODY_SIZE_BYTES=1048576

# ---- Postgres (application data) -----------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=app

# ---- Keycloak ------------------------------------------------------------
KC_DB_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_REALM=bap
KEYCLOAK_AUDIENCE=bap-backend
# Confidential BFF client. Take the value from Clients -> bap-backend ->
# Credentials in the admin console (the realm import ships a dev placeholder
# that validate_for_production() rejects).
OIDC_CLIENT_ID=bap-backend
OIDC_CLIENT_SECRET=CHANGE_ME
# Service account used by provision_tenant.py (Keycloak group per tenant).
# Leave the secret empty to disable admin integration entirely.
KEYCLOAK_ADMIN_CLIENT_ID=bap-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME

# ---- Redis + sessions ----------------------------------------------------
# Redis holds live access/refresh tokens: a password is mandatory in prod.
REDIS_PASSWORD=CHANGE_ME
# AES-256-GCM keys (base64, 32 bytes) encrypting those tokens at rest.
# Generate: openssl rand -base64 32     (rotate by prepending a new key)
SESSION_ENCRYPTION_KEYS=CHANGE_ME
SESSION_COOKIE_NAME=bap_session
SESSION_TTL_SECONDS=36000
SESSION_IDLE_SECONDS=1800

# ---- Rate limiting -------------------------------------------------------
RATE_LIMIT_GLOBAL_PER_MINUTE=120
RATE_LIMIT_WRITES_PER_MINUTE=30
RATE_LIMIT_TENANT_PER_MINUTE=6000
RATE_LIMIT_AUTH_PER_MINUTE_PER_IP=20

# ---- Object storage (documents) ------------------------------------------
# Prod rejects a plain-http S3 endpoint, so the built-in MinIO is reached over
# TLS through the edge nginx on :9443 — a port that is NOT published to the host,
# so MinIO stays internal. Replace APP_HOST below with your app host, or point
# S3_ENDPOINT_URL at an external https S3 and scale the `minio` service to 0.
S3_ENDPOINT_URL=https://korxona.com:9443
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_REGION=us-east-1
S3_BUCKET_PREFIX=bap

# ---- AI intake — PERSONAL DATA LEAVES THE COUNTRY ------------------------
# Empty key = the AI chat intake is disabled (503). Chat turns and uploaded
# document text are sent to the provider; voice audio is sent to Modal. Both
# contradict the "PII localization in Uzbekistan" NFR — leave empty unless the
# egress has been approved in writing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_URL=
TRANSCRIPTION_MODAL_KEY=
TRANSCRIPTION_MODAL_SECRET=
